{
  "name": "imageservice",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/handler.js",
    "local:get": "tsx scripts/run-local.ts events/get-image.json",
    "local:delete": "tsx scripts/run-local.ts events/delete-image.json",
    "local:presign": "tsx scripts/run-local.ts events/presign.json",
    "local:unknown": "tsx scripts/run-local.ts events/unknown.json",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "infra:init": "terraform -chdir=infra/terraform init -reconfigure",
    "infra:ws:dev": "terraform -chdir=infra/terraform workspace select dev || terraform -chdir=infra/terraform workspace new dev",
    "infra:ws:prod": "terraform -chdir=infra/terraform workspace select prod || terraform -chdir=infra/terraform workspace new prod",
    "infra:apply": "terraform -chdir=infra/terraform apply -auto-approve",
    "infra:apply:dev": "terraform -chdir=infra/terraform apply -var-file=env/dev.tfvars -auto-approve",
    "infra:apply:prod": "terraform -chdir=infra/terraform apply -var-file=env/prod.tfvars -auto-approve",
    "infra:bootstrap:init": "terraform -chdir=infra/bootstrap init",
    "infra:bootstrap:apply": "terraform -chdir=infra/bootstrap apply -auto-approve",
    "infra:destroy:dev": "terraform -chdir=infra/terraform workspace select dev && terraform destroy -var-file=env/dev.tfvars",
    "infra:package": "rm -rf dist && npm run build && npm ci --omit=dev && cp -r node_modules dist/ && cd dist && zip -r handler.zip . && cd .. && npm install",
    "infra:outputs": "terraform -chdir=infra/terraform output -json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.940.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/lib-dynamodb": "^3.940.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
